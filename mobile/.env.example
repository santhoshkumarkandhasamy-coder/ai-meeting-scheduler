# Backend URL reachable from the phone (use your computer's LAN IP, not localhost)
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
# OAuth "Web application" client ID (the same one the backend uses)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# OAuth "iOS" client ID (iOS only)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Claude API
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5-5
# low = fastest spoken replies; use medium/high for more careful reasoning
ANTHROPIC_EFFORT=low

# Google OAuth "Web application" client (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# Long random string for signing app session tokens
JWT_SECRET=replace-with-a-long-random-string
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# SQLite for local dev; Postgres in production, e.g.
# DATABASE_URL=postgresql+psycopg://meeting:meeting@db:5432/meeting
DATABASE_URL=sqlite:///./meeting_assistant.db

SCHEDULER_ENABLED=true
REMINDER_POLL_SECONDS=60
